{
    "pack": {
        "description": "enchanteraser resources",
        "pack_format": 3,
        "_comment": "Load-bearing, not boilerplate: without this file the jar's assets/ never becomes a resource domain, so assets/enchanteraser/lang/en_us.lang is never read and enchanteraser.tooltip.erased renders as its own key on every erased item. pack_format 3 is the 1.11+ value and is what makes lowercase en_us.lang correct; 2 would route through LegacyV2Adapter and demand en_US.lang."
    }
}
