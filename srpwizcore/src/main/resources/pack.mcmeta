{
    "pack": {
        "description": "srpwizcore resources",
        "pack_format": 3,
        "_comment": "Load-bearing, not boilerplate: without this file the jar's assets/ never becomes a resource domain, so assets/srpwizcore/lang/en_us.lang is never read and the dormant waystone shows as 'tile.srpwizcore.dormant_waystone.name'. pack_format 3 is the 1.11+ value and is what makes lowercase en_us.lang correct; 2 would route through LegacyV2Adapter and demand en_US.lang."
    }
}
