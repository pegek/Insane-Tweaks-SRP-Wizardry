{
    "pack": {
        "description": "tombtweaks resources",
        "pack_format": 3,
        "_comment": "Load-bearing, not boilerplate: without this file the jar's assets/ never becomes a resource domain, so assets/tombtweaks/lang/en_us.lang is never read and every key falls through to its own name - the two custom perks rendered as 'tombstone.perk.relief_for_the_damned' and the inventory tab as 'tombtweaks.tab.knowledge' (2026-08-04). pack_format 3 is the 1.11+ value and is what makes lowercase en_us.lang correct; 2 would route through LegacyV2Adapter and demand en_US.lang."
    }
}
